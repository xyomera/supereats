{
	"schemaVersion": 1,
	"id": "supereats",
	"version": "${version}",
	"name": "supereats",
	"description": "This is an food mod.",
	"authors": [
		"xyomera"
	],
	"contact": {
		"homepage": "",
		"sources": "https://github.com/xyomera/supereats"
	},
	"license": "Apache 2.0",
	"icon": "assets/supereats/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.xyomera.Supereats",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.xyomera.client.SupereatsClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "com.xyomera.client.SupereatsDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"supereats.mixins.json",
		{
			"config": "supereats.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"java": ">=25",
		"minecraft": "~26.2",
		"fabricloader": ">=0.19.5",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}